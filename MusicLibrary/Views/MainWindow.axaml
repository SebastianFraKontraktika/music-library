<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibrary.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
        x:Class="MusicLibrary.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MusicLibrary"
        Background="Black"
        Width="1400"
        Height="700">
    <Window.Styles>
        <Style Selector="RadioButton">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="Violet"/>
        </Style>
        <Style Selector="RadioButton:checked">
            <Setter Property="Background" Value="BlueViolet"/>
            <Setter Property="Foreground" Value="HotPink"/>
        </Style>
        <Style Selector="TextBox.nameInput">
            <Setter Property="MinHeight" Value="0"></Setter>
            <Setter Property="MinWidth" Value="0"></Setter>
            <Setter Property="Height" Value="20"></Setter>
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="FontSize" Value="10"></Setter>
            <Setter Property="Padding" Value="5,2"></Setter>
            <Setter Property="Margin" Value="0"></Setter>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <StackPanel>
        <StackPanel Name="Header"
                    Height="200">
            <Border BorderBrush="Brown" 
                    BorderThickness="0,0,0,10" 
                    Margin="150,15" 
                    Padding="0,5,0,5">
                <TextBlock TextAlignment="Center"
                           FontSize="50"
                           Foreground="white">
                    Music Library
                </TextBlock>
            </Border>
            <Grid
                HorizontalAlignment="Right"
                ColumnDefinitions="Auto,Auto"
                RowDefinitions="Auto">
                <Button Content="Edit"
                        Name="EditButton"
                        Click="editSongButton_OnClick"
                    Grid.Row="0" Grid.Column="0" Margin="15" 
                        Background="Brown" Foreground="White">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#631919"></Setter>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="New"
                        Name="NewButton"
                        Click="AddSongButton_OnClick"
                    Grid.Row="0" Grid.Column="1" Margin="0,0,150,0" 
                        Background="Brown" Foreground="White">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#631919"></Setter>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="Save"
                        Name="SaveButton"
                        IsVisible="False"
                        Click="saveButton_OnClick"
                        Grid.Row="0" Grid.Column="1" Margin="0,0,150,0" 
                        Background="Brown" Foreground="White">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#631919"></Setter>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="Delete"
                        Name="DeleteButton"
                        IsVisible="False"
                        Click="deleteButton_OnClick"
                        Grid.Row="0" Grid.Column="0" Margin="15" 
                        Background="Brown" Foreground="White">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#631919"></Setter>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </StackPanel>
        <Grid HorizontalAlignment="Center">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Name="ScrollViewerLibrary">
                <WrapPanel 
                      ItemHeight="225"
                      ItemWidth="225"
                      Margin="100,5"
                      Name="LibraryGrid">
                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </StackPanel>
</Window>
